{
  "name": "brand-verification-review-dashboard",
  "version": "1.0.0",
  "description": "Restricted Admin2 dashboard for reviewing brand verification applications",
  "main": "dist/index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",

  "keywords": [
    "retool",
    "custom-component",
    "react",
    "starter"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.18.6",
    "@babel/preset-env": "^7.18.6",
    "@babel/preset-react": "^7.18.6",
    "@tryretool/custom-component-support": "^1.7.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
